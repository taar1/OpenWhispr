#!/bin/sh
# Scans every commit being pushed that the remote doesn't have yet.
z=0000000000000000000000000000000000000000
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then
    "$(dirname "$0")/secret-scan.sh" range "$lsha" --not --remotes || exit 1
  else
    "$(dirname "$0")/secret-scan.sh" range "$rsha..$lsha" || exit 1
  fi
done
exit 0
